{
  "compilerOptions": {
    "composite": false,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "resolveJsonModule": true,
    "target": "ES2020",
    "noEmit": true
  },
  "include": [
    "vite.config.ts",
    "src/config/appBranding.ts",
    "src/pwa/startupMarkup.ts",
    "src/data/Text_EN.json"
  ]
}
