{
  "name": "pos",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && tsc -p tsconfig.node.json && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "deploy": "gh-pages -d dist",
    "test": "node --import tsx --test --test-timeout=15000 tests/*.test.ts",
    "test:watch": "node --import tsx --test --watch tests/*.test.ts",
    "test:coverage": "node --import tsx --test --test-timeout=15000 --experimental-test-coverage --test-coverage-include=src/** tests/*.test.ts",
    "test:types": "tsc -p tsconfig.tests.json && tsc -p tsconfig.node.json",
    "check": "npm run test:types && npm run lint:tests && npm test && npm run build",
    "test:browser": "npm run build && npm run test:browser:run",
    "test:all": "npm run check && npm run test:browser:run",
    "lint:tests": "eslint tests --ext ts --max-warnings 0",
    "assets:generate": "node --import tsx scripts/generate-brand-assets.ts",
    "assets:screenshots": "node --import tsx scripts/capture-install-screenshots.ts",
    "test:browser:run": "node --import tsx --test --test-timeout=120000 tests/browser/*.test.ts"
  },
  "dependencies": {
    "@tanstack/react-table": "^8.21.3",
    "fflate": "^0.8.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^5.5.0",
    "react-router-dom": "^6.22.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitejs/plugin-react": "^4.2.1",
    "dotenv": "^16.4.4",
    "eslint": "^8.56.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "fake-indexeddb": "^6.2.7",
    "playwright": "^1.65.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^5.2.2",
    "vite": "^5.1.0",
    "vite-plugin-pwa": "^0.19.0"
  }
}
